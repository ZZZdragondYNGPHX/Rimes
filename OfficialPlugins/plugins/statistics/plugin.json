{
  "id": "builtin.statistics",
  "nameZH": "统计",
  "nameEN": "Statistics",
  "summaryZH": "统计官方插件；用户数据由 RIMES 宿主管理。",
  "summaryEN": "Statistics official plugin; user data remains owned by the RIMES host.",
  "schemaVersion": 2,
  "version": "2.0.0",
  "kind": "extension",
  "sdkVersion": 1,
  "minimumHostVersion": "1.1.0",
  "runtime": "host-interpreted",
  "platforms": {
    "macos": {
      "legacyID": "builtin.statistics",
      "distribution": "bundled"
    }
  },
  "capabilities": [
    "metrics.aggregate"
  ],
  "contribution": {
    "type": "metrics.v1",
    "options": {
      "events": "key-count,commit-count",
      "storage": "local"
    }
  },

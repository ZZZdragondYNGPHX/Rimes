/platforms/android/app/src/main/java/org/scholay/rimes/android/ChordPreview.java
/platforms/android/app/src/main/java/org/scholay/rimes/android/ChordSurface.java
/platforms/android/app/src/main/java/org/scholay/rimes/android/OfflineDictionary.java
/platforms/android/app/src/main/java/org/scholay/rimes/android/OpenAiChatCodec.java
/Shared/Sources/RimesCore/Resources/OfficialPlugins/
